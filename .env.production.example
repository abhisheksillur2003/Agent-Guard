# Copy this file to .env.production and replace every placeholder.
DOMAIN=agentguard.example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=agentguard
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
REDIS_PASSWORD=replace-with-an-independent-random-password

AGENTGUARD_ENVIRONMENT=production
AGENTGUARD_LOG_LEVEL=INFO
AGENTGUARD_API_DOCS_ENABLED=false
AGENTGUARD_ALLOWED_HOSTS=["agentguard.example.com","api"]
AGENTGUARD_DATABASE_URL=postgresql+asyncpg://agentguard:replace-with-a-url-safe-random-password@postgres:5432/agentguard
AGENTGUARD_REDIS_URL=redis://:replace-with-an-independent-random-password@redis:6379/0
AGENTGUARD_AUTH_SIGNING_KEY=replace-with-at-least-32-random-characters
AGENTGUARD_AGENT_KEY_PEPPER=replace-with-an-independent-random-secret
AGENTGUARD_FINDING_FINGERPRINT_PEPPER=replace-with-an-independent-random-secret
AGENTGUARD_ACCESS_TOKEN_MINUTES=30
AGENTGUARD_APPROVAL_TTL_HOURS=24
AGENTGUARD_EXECUTION_DECISION_TTL_MINUTES=15
AGENTGUARD_STALE_EXECUTION_SECONDS=300
AGENTGUARD_OTEL_SERVICE_NAME=agentguard-api
AGENTGUARD_LOCAL_AI_ENABLED=false

WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
