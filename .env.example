# Local development only. Replace these values outside local development.
AGENTGUARD_ENVIRONMENT=local
AGENTGUARD_LOG_LEVEL=INFO
AGENTGUARD_DATABASE_URL=postgresql+asyncpg://agentguard:change-me-local-only@localhost:5432/agentguard
AGENTGUARD_AUTH_SIGNING_KEY=replace-with-at-least-32-random-characters
AGENTGUARD_AGENT_KEY_PEPPER=replace-with-an-independent-random-secret
AGENTGUARD_FINDING_FINGERPRINT_PEPPER=replace-with-an-independent-random-secret
AGENTGUARD_ACCESS_TOKEN_MINUTES=30
AGENTGUARD_APPROVAL_TTL_HOURS=24
AGENTGUARD_EXECUTION_DECISION_TTL_MINUTES=15
AGENTGUARD_REDIS_URL=redis://localhost:6379/0
AGENTGUARD_STALE_EXECUTION_SECONDS=300

POSTGRES_DB=agentguard
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379
